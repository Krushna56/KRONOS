# Copy this file to .env and replace all placeholder values.
APP_NAME=KRONOS
APP_ENV=development

# PostgreSQL (docker-compose exposes the container on localhost:5433)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-strong-password
POSTGRES_DB=aiclone
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-unique-strong-password@localhost:5433/aiclone
REDIS_URL=redis://localhost:6379

# Authentication: generate a unique random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated frontend origins; do not use * with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Platform Tokens (Optional)
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
GMAIL_CREDENTIALS_JSON=
LINKEDIN_ACCESS_TOKEN=

# Optional integrations
GEMINI_API_KEY=
GROQ_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
