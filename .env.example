# ───────────────────────────────────────────────────────────────
# KRONOS configuration — copy to `.env` and fill in real values.
# NEVER commit `.env`. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ───────────────────────────────────────────────────────────────

# Application
APP_NAME=KRONOS
APP_ENV=development            # development | production

# Database (PostgreSQL + pgvector) — must match docker-compose.yml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=aiclone
DATABASE_URL=postgresql+asyncpg://postgres:change_me_db_password@localhost:5433/aiclone
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=change_me_to_a_random_48_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Registration closes after the first (owner) account is created unless this is true
ALLOW_REGISTRATION=false
# Shared secret for the Mini Robot (sent as X-Robot-Key header). Empty = robot endpoints disabled.
ROBOT_API_KEY=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=

# Platform integrations (optional)
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
GMAIL_CREDENTIALS_JSON=
GMAIL_TOKEN_JSON=
LINKEDIN_ACCESS_TOKEN=
GOOGLE_CALENDAR_CREDENTIALS_JSON=credentials.json
GOOGLE_CALENDAR_TOKEN_JSON=calendar_token.json

# Telephony (Twilio) — AUTH_TOKEN is also used to verify webhook signatures
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
